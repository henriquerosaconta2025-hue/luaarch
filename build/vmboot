#!/usr/bin/sh
set -e

qemu-system-x86_64 \
    -kernel luaarch/boot/vmlinuz \
    -initrd luaarch/boot/iniramfs.cpio.gz \
    -append "console=ttyS0 loglevel=8 rdinit=/init /dev/ttyS0" \
    -drive file=luaarch-rootfs.img,format=raw,if=virtio \
    -netdev user,id=net0 \
    -device virtio-net-pci,netdev=net0 \
    -smp 1,sockets=1,cores=1,threads=1 \
    -m 1G \
    -nographic
