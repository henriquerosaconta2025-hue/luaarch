#!/usr/bin/env -S luajit

local ffi = require("ffi")
local bit = require("bit")

ffi.cdef[[
    struct in_addr {
        uint32_t s_addr;
    };

    struct sockaddr_in {
        int16_t        sin_family;
        uint16_t       sin_port;
        struct in_addr sin_addr;
        char           sin_zero[8];
    };

    struct rtentry {
        unsigned long   rt_pad1;
        struct sockaddr_in rt_dst;
        struct sockaddr_in rt_gateway;
        struct sockaddr_in rt_genmask;
        unsigned short  rt_flags;
        short           rt_pad2;
        unsigned long   rt_pad3;
        void           *rt_tos;
        void           *rt_class;
        short           rt_pad4[3];
        char           *rt_dev;
        unsigned long   rt_pad5;
        unsigned long   rt_pad6;
    };

    int socket(int domain, int type, int protocol);
    int ioctl(int fd, unsigned long request, struct rtentry *arg);
    int inet_pton(int af, const char *src, void *dst);
    char *strerror(int errnum);
    int close(int fd);
]]

local C = ffi.C

function syserr()
    return ffi.string(C.strerror(ffi.errno()))
end

function setgateway(gatewayip)
    if not gatewayip then
        print("Error: No IP address provided.")
        return false
    end

    local fd = C.socket(2, 2, 0)
    if fd < 0 then
        print("Failed to open socket: " .. syserr())
        return false
    end

    local rt = ffi.new("struct rtentry")
    ffi.fill(rt, ffi.sizeof(rt), 0)

    rt.rt_gateway.sin_family = 2

    local gateway_addr_ptr = ffi.cast("char *", rt) + ffi.offsetof("struct rtentry", "rt_gateway") + ffi.offsetof("struct sockaddr_in", "sin_addr")
    local ptonret = C.inet_pton(2, gatewayip, ffi.cast("void *", gateway_addr_ptr))

    if ptonret <= 0 then
        print("Error: Invalid IPv4 Address format string.")
        C.close(fd)
        return false
    end

    rt.rt_dst.sin_family = 2
    rt.rt_dst.sin_addr.s_addr = 0
    rt.rt_genmask.sin_family = 2
    rt.rt_genmask.sin_addr.s_addr = 0
    rt.rt_flags = bit.bor(0x0001, 0x0002)

    print("attempting to set gateway to " .. gatewayip .. "...")

    local ret = C.ioctl(fd, 0x890B, rt)

    if ret < 0 then
        print("ioctl error: " .. syserr())
        C.close(fd)
        return false
    end

    print("gateway updated")
    C.close(fd)
    return true
end

local targetip = arg[1]
setgateway(targetip)